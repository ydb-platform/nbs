+void RestoreNodesTags(NFyaml::TNodeRef rootNode, const TElementsTags& tags) {
+    std::stack<NFyaml::TNodeRef> nodes;
+
+    nodes.push(rootNode);
+
+    while (!nodes.empty()) {
+        auto node = nodes.top();
+        nodes.pop();

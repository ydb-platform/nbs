+void DeepCopyTags(NFyaml::TNodeRef node) {
+    if (auto tag = node.Tag()) {
+        node.SetTag(*tag);
+    }
+    switch (node.Type()) {
+        case NFyaml::ENodeType::Mapping:
+            for (auto& pair : node.Map()) {
+                DeepCopyTags(pair.Value());
+            }
+            break;
+        case NFyaml::ENodeType::Sequence:
+            for (auto& item : node.Sequence()) {
+                DeepCopyTags(item);
+            }
+            break;
+        default:
+            break;
+    }

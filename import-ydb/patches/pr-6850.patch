+
+        runtime.SetObserverFunc(observer);
+        notifications = 0;
+
+        // Replace yaml with different cluster_name -> isYamlChanged=true
+        TString yamlConfig2 = R"(
+---
+metadata:
+  cluster: ""
+  version: 1
+
+config:
+  log_config:
+    cluster_name: cluster2

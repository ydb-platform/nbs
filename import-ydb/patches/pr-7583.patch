+#pragma once
+
+#include <contrib/ydb/library/actors/core/actorid.h>
+#include <contrib/ydb/library/actors/core/event_local.h>
+#include <contrib/ydb/library/actors/core/mon.h>
+#include <contrib/ydb/library/actors/util/rc_buf.h>
+
+#include <library/cpp/monlib/dynamic_counters/counters.h>
+
+#include "event_destructor.h"
+#include "interconnect_stream.h"
+#include "types.h"
+
+#include <memory>
+#include <vector>
+
+namespace NActors {
+
+    class IReceiveCallback;
+    struct TInterconnectProxyCommon;
+
+    class IUringEngine;
+    using TUringEnginePtr = TIntrusivePtr<IUringEngine>;
+
+    class IUringEngineClient : public IEventDestructor {
+    public:
+        virtual ~IUringEngineClient() = default;
+
+        // Called by SetClient before any connection is registered. Arranges engine shutdown.
+        virtual void Start(const TUringEnginePtr& engine) = 0;
+
+        // Called once after all engine workers have stopped, before the event destination is torn down.
+        // Completes pending client work, including the final destruction batch.
+        virtual void Stop() = 0;
+
+        // Takes ownership of the event. May be called concurrently from engine worker threads.
+        virtual void Send(std::unique_ptr<IEventHandle> ev) = 0;
+    };
+
+    using IUringEngineClientPtr = std::shared_ptr<IUringEngineClient>;
+
+    class IUringEngine : public TThrRefBase {
+    public:
+        // Installs the client before the first Register. Must be called exactly once, before any
+        // worker can send an event. Keeps the client alive and calls its Start method.
+        virtual void SetClient(IUringEngineClientPtr client) = 0;
+
+        // Registers a connected socket, arms receiving, and returns an opaque non-zero handle (0 on
+        // failure). The engine holds a reference to the socket until Unregister fully drains. Thread-safe.
+        virtual ui64 Register(TIntrusivePtr<NInterconnect::TStreamSocket> socket, const TActorId& sessionActorId,
+            TScopeId peerScopeId, std::function<void(TDisconnectReason)> onDisconnectCallback,
+            bool sendPings, std::shared_ptr<std::atomic<int64_t>> clockSkew, std::shared_ptr<std::atomic<uint64_t>> pingRTT,
+            TIntrusivePtr<NInterconnect::TStreamSocket> xdcSocket = {}) = 0;
+
+        // Put a message into outgoing queue. Thread-safe.
+        virtual void Send(ui64 conn, std::unique_ptr<IEventHandle> ev, TIntrusivePtr<IReceiveCallback> callback = nullptr) = 0;
+
+        // Cancels the connection's IO and tears it down; TEvUringV2Unregistered is posted once every
+        // outstanding operation has drained. Thread-safe.
+        virtual void Unregister(ui64 conn) = 0;
+
+        // Register receive callback (for IDirectSession). Null callback deregisters it.
+        virtual void RegisterReceiveCallback(ui64 conn, TActorId localActorId, TIntrusivePtr<IReceiveCallback> callback) = 0;
+
+        // Stops every reaper thread. Must be called before the client's event destination is torn down.
+        virtual void Stop() = 0;
+
+        // Issue monitoring request.
+        virtual void IssueMonRequest(ui64 conn, NMon::TEvHttpInfoRes::TPtr ev) = 0;
+
+        // Get total output queue size (in bytes).
+        virtual ui64 GetTotalOutputQueueSize(ui64 conn) = 0;
+    };
+
+    // Creates the engine, taking every knob it needs from `common` (which it keeps a reference to, so
+    // sessions can read the shared settings): Settings.V2.UringEngineThreads worker threads (clamped to
+    // >= 1), each driving Settings.V2.UringEngineRingsPerShard io_uring rings (clamped to >= 1). With
+    // SQPOLL, each ring has its own kernel poll thread, so rings-per-shard scales submission-polling
+    // capacity independently of serialization workers.
+    // The engine is created without a client; install one via SetClient before the first Register.
+    // Returns nullptr when io_uring is unavailable (non-Linux or a kernel that cannot create a ring).
+    //
+    // When the kernel SQPOLL thread is saturated while shard workers still have headroom, try
+    // EnableSQPOLL=false (submit from the underutilized worker) or raise UringEngineRingsPerShard. When
+    // workers are the bottleneck, raise UringEngineThreads / lower UringEngineRingsPerShard.
+    // With EnableFixedFiles, each ring reserves UringEngineFixedFilesPerRing slots via
+    // io_uring_register_files (sparse); session sockets are bound with register_files_update and
+    // submitted with IOSQE_FIXED_FILE. Unsupported kernels or a full table fall back to plain fds.
+    // With EnableProvidedBuffers, idle/min-size sessions recv via BUFFER_SELECT from a shared pool
+    // (buf_ring when available, else provide_buffers). YDB_IC_V2_DISABLE_BUF_RING forces the non-buf_ring
+    // pool path for testing.
+    //
+    // Common holds the engine via an intrusive pointer too; the resulting cycle is broken by Stop().
+    TUringEnginePtr CreateUringEngine(TIntrusivePtr<TInterconnectProxyCommon> common);
+
+}
diff --git a/contrib/ydb/library/actors/interconnect/interconnect_uring_engine_client.cpp b/contrib/ydb/library/actors/interconnect/interconnect_uring_engine_client.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..07106113aacea65053bc28c1c15340092d651241
--- /dev/null
+++ b/contrib/ydb/library/actors/interconnect/interconnect_uring_engine_client.cpp
@@ -0,0 +1,130 @@
+#include "interconnect_uring_engine_client.h"
+
+#include "interconnect_common.h"
+
+#include <contrib/ydb/library/actors/core/actorsystem.h>
+
+#include <util/datetime/cputimer.h>
+
+#include <atomic>
+#include <mutex>
+
+namespace NActors {
+    namespace {
+
+        constexpr size_t MaxDestructionBatchObjects = 256;
+        constexpr size_t MaxDestructionBatchBytes = 64 * 1024;
+
+        struct TEvDestroyEvents : TEventLocal<TEvDestroyEvents, 0> {
+            std::vector<std::unique_ptr<IEventBase>> Events;
+            std::vector<TIntrusivePtr<TEventSerializedData>> Buffers;
+            size_t Bytes = 0;
+            std::shared_ptr<std::atomic<TAtomicBase>> Counter;
+
+            ~TEvDestroyEvents() {
+                if (Counter) {
+                    Counter->fetch_sub(Bytes, std::memory_order_relaxed);
+                }
+            }
+        };
+
+        class TActorSystemUringEngineClient final
+            : public IUringEngineClient
+        {
+            TActorSystem& ActorSystem;
+            const TActorId DestructorActorId;
+            const std::shared_ptr<std::atomic<TAtomicBase>> DestructorQueueSize;
+            const size_t MaxDestructorQueueSize;
+            std::mutex Mutex;
+            std::unique_ptr<TEvDestroyEvents> PendingDestruction;
+            std::atomic<ui64> DestroyEventsCycles{0};
+
+        public:
+            TActorSystemUringEngineClient(
+                    TActorSystem& actorSystem,
+                    const TInterconnectProxyCommon& common)
+                : ActorSystem(actorSystem)
+                , DestructorActorId(common.DestructorId)
+                , DestructorQueueSize(common.DestructorQueueSize)
+                , MaxDestructorQueueSize(common.MaxDestructorQueueSize)
+            {
+            }
+
+            void Start(const TUringEnginePtr& engine) override {
+                ActorSystem.DeferPreStop([engine] { engine->Stop(); });
+            }
+
+            void Stop() override {
+                std::unique_ptr<TEvDestroyEvents> ev;
+                {
+                    std::lock_guard guard(Mutex);
+                    ev = std::move(PendingDestruction);
+                }
+                Flush(std::move(ev));
+            }
+
+            ui64 GetAndResetDestroyEventsCycles() override {
+                return DestroyEventsCycles.exchange(0, std::memory_order_relaxed);
+            }
+
+            void Send(std::unique_ptr<IEventHandle> ev) override {
+                ActorSystem.Send(ev.release());
+            }
+
+            void DestroyEvent(
+                    std::unique_ptr<IEventBase> event,
+                    TIntrusivePtr<TEventSerializedData> buffer) override {
+                const ui64 start = GetCycleCountFast();
+                const size_t bytes =
+                    (event ? event->CalculateSerializedSizeCached() : 0) +
+                    (buffer ? buffer->GetSize() : 0);
+                std::unique_ptr<TEvDestroyEvents> ev;
+                {
+                    std::lock_guard guard(Mutex);
+                    if (!PendingDestruction) {
+                        PendingDestruction = std::make_unique<TEvDestroyEvents>();
+                    }
+                    if (event) {
+                        PendingDestruction->Events.push_back(std::move(event));
+                    }
+                    if (buffer) {
+                        PendingDestruction->Buffers.push_back(std::move(buffer));
+                    }
+                    PendingDestruction->Bytes += bytes;
+                    if (PendingDestruction->Bytes >= MaxDestructionBatchBytes ||
+                            PendingDestruction->Events.size() + PendingDestruction->Buffers.size() >=
+                                MaxDestructionBatchObjects) {
+                        ev = std::move(PendingDestruction);
+                    }
+                }
+                Flush(std::move(ev));
+                DestroyEventsCycles.fetch_add(GetCycleCountFast() - start, std::memory_order_relaxed);
+            }
+
+        private:
+            void Flush(std::unique_ptr<TEvDestroyEvents> ev) {
+                if (!ev) {
+                    return;
+                }
+                ev->Counter = DestructorQueueSize;
+                if (Y_LIKELY(!DestructorQueueSize ||
+                        DestructorQueueSize->fetch_add(ev->Bytes, std::memory_order_relaxed) + ev->Bytes <=
+                            MaxDestructorQueueSize)) {
+                    Send(std::make_unique<IEventHandle>(
+                        DestructorActorId,
+                        TActorId(),
+                        ev.release()));
+                }
+            }
+        };
+
+    }
+
+    IUringEngineClientPtr CreateUringEngineClient(
+            const TInterconnectProxyCommon& common,
+            TActorSystem* actorSystem) {
+        Y_ABORT_UNLESS(actorSystem);
+        return std::make_shared<TActorSystemUringEngineClient>(*actorSystem, common);
+    }
+
+}

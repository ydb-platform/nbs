+        constexpr ui64 numSmall = 40;
+        for (ui64 i = 1; i <= numSmall; ++i) {
+            ser.Push(MakeCordEventHandle(/*channel=*/2, i, static_cast<char>('a' + (i % 26)), 1000));
+        }

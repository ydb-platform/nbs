 package yandex.cloud.priv.compute.v1.inner;
 
+import "contrib/ydb/public/api/client/yc_private/compute/export.proto";
+
 option go_package = "github.com/ydb-platform/nbs/contrib/ydb/public/api/client/yc_private/compute/inner;compute";
 
 service DiskService {
   // Create iam-token for encrypted disk
   rpc CreateToken(CreateTokenRequest) returns (CreateTokenResponse);
+
+  rpc GetExportCredentials(GetExportCredentialsRequest)
+      returns (GetExportCredentialsResponse);
 }
 
 message CreateTokenRequest {
@@ -17,3 +22,14 @@ message CreateTokenRequest {
 message CreateTokenResponse {
   string token = 1;
 }
+
+message GetExportCredentialsRequest {
+  // Compute export task ID passed to Disk Manager in x-task-id.
+  string task_id = 1;
+  string snapshot_id = 2;
+  string image_id = 3;
+}
+
+message GetExportCredentialsResponse {
+  yandex.cloud.priv.compute.v1.ExportS3Credentials credentials = 1;
+}

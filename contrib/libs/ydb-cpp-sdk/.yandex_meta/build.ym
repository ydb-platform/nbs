{% extends '//builtin/run.ym' %}

{% block current_version %}3.3.1{% endblock %}

{% block current_url %}
https://github.com/ydb-platform/ydb-cpp-sdk/archive/v{{self.version().strip()}}.tar.gz
{% endblock %}

{% set no_license_analyzer = true %}

{% block unpack_source %}
{{super()}}
tar xf ${RESOURCES}/{{self.current_url().strip() | basename}} --strip-components=1
find . -mindepth 1 -maxdepth 1 \
    ! \( -name '.yandex_meta' -o -name 'src' -o -name 'tests' -o -name 'include' -o -name 'LICENSE' -o -name 'README.md' \) \
    -exec rm -rf {} +
{% endblock %}

{% block patch_source %}
SED_INCLUDE='(^\s*#include\s*)(<|\")'

find . -type f -regex ".*\(h\|cpp\|cpp.in\|c\|ipp\|proto\)$" | while read f;
do
    sed -i -E \
        's/'$SED_INCLUDE'src\/api\//\1\2contrib\/ydb\/public\/api\//g;
         s/'$SED_INCLUDE'src\/library\/operation_id\/protos/\1\2contrib\/ydb\/public\/sdk\/cpp\/src\/library\/operation_id\/protos/g;
         s/'$SED_INCLUDE'ydb-cpp-sdk\/library\/retry\/retry_policy\.h/\1\2library\/cpp\/retry\/retry_policy\.h/g;
         s/'$SED_INCLUDE'src\/library\/string_utils\/base64\/base64\.h/\1\2library\/cpp\/string_utils\/base64\/base64\.h/g
         s/'$SED_INCLUDE'src\/library\/operation_id\/protos\//\1\2contrib\/libs\/ydb-cpp-sdk\/src\/library\/operation_id\/protos\//g' $f
done

echo \
"#pragma once

#include <util/generic/string.h>

namespace NYdb {
inline namespace V3 {

using TStringType = TString;

}
}" > include/ydb-cpp-sdk/type_switcher.h
{% endblock %}

{% block prepare_yamake %}
cat << EOF > sdk_common.inc
# Generated by devtools/yamaker/ym2

LICENSE(Apache-2.0)

WITHOUT_LICENSE_TEXTS()

SUBSCRIBER(
    g:ydb_appteam_cpp
    g:cpp-contrib
)

VERSION({{self.version().strip()}})

ORIGINAL_SOURCE({{self.current_url().strip()}})

ADDINCL(
    GLOBAL contrib/libs/ydb-cpp-sdk/include
    contrib/libs/ydb-cpp-sdk
)
EOF
{% endblock %}

{% block move_to_output %}
{{super()}}
cp -R include/ src/ tests/ sdk_common.inc ${OUTPUT}/
rm -r ${OUTPUT}/src/library/benchmark ${OUTPUT}/src/library/malloc ${OUTPUT}/src/library/proto_output \
      ${OUTPUT}/src/library/retry ${OUTPUT}/src/library/string_utils/base64 \
      ${OUTPUT}/src/client/federated_topic/ut ${OUTPUT}/src/client/persqueue_public/ut ${OUTPUT}/src/client/topic/ut \
      ${OUTPUT}/src/api
rm -r ${OUTPUT}/include/ydb-cpp-sdk/library/retry
rm -r ${OUTPUT}/tests/unit/client/params ${OUTPUT}/tests/unit/client/value
{% endblock %}

{% block step_install %}
rsync -c -I -W -r --delete --perms --exclude '**/ya.make' --filter '- **/CMakeLists.txt' ${OUTPUT}/ ${DST_PATH}
{% endblock %}

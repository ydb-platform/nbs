{
  "name": "NBS: allow pull_request_target for fork notifier",
  "enforcement": "disabled",
  "conditions": {
    "workflow_path": {
      "include": [
        ".github/workflows/check-pr-source.yaml"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "restrict_action_events",
      "parameters": {
        "allowed_events": [
          "pull_request_target"
        ]
      }
    }
  ]
}

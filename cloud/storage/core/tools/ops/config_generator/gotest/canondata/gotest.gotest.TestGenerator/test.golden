/extra_configs/nbs-domains.txt:
Domain {
  DomainId: 1
  SchemeRoot: 1
  SSId: 1
  HiveUid: 1
  PlanResolution: 10
  Name: "example_global"
}
StateStorage {
  SSId: 1
  Ring {
    NToSelect: 1
    Node: 1
  }
}

/extra_configs/nbs-names.txt:
Node {
  NodeId: 1
  Port: 19001
  Host: "node-1.example-cluster.internal"
  InterconnectHost: "node-1.example-cluster.internal"
  Location {
    DataCenter: "zone-a"
    Rack: "rack-1:1"
    Body: 1
  }
}
ClusterUUID: "00000000"
AcceptUUID: "00000000"


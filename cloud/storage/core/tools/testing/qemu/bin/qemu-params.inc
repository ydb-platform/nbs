IF(ARCH_X86_64)
    IF (QEMU_RECONNECT == "")
        SET(QEMU_RECONNECT 1)
    ENDIF()
    IF (QEMU_VIRTIOFS_MIGRATION == "")
        SET(QEMU_VIRTIOFS_MIGRATION external)
    ENDIF()
ELSEIF (ARCH_ARM64)
    IF (QEMU_BIOS == "")
        SET(QEMU_BIOS usr/share/qemu/edk2-aarch64-code.fd)
    ENDIF()
ENDIF()

IF (QEMU_BIN != "")
    ENV(QEMU_BIN=${QEMU_BIN})
ENDIF()
IF (QEMU_FIRMWARE != "")
    ENV(QEMU_FIRMWARE=${QEMU_FIRMWARE})
ENDIF()
IF (QEMU_BIOS != "")
    ENV(QEMU_BIOS=${QEMU_BIOS})
ENDIF()
IF (QEMU_RECONNECT != "")
    ENV(QEMU_RECONNECT=${QEMU_RECONNECT})
ENDIF()
IF (QEMU_VIRTIOFS_MIGRATION != "")
    ENV(QEMU_VIRTIOFS_MIGRATION=${QEMU_VIRTIOFS_MIGRATION})
ENDIF()
